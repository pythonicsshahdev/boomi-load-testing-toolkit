# Credentials for the system(s) under test — used by JMeter's HTTP
# Authorization Manager / HTTP Header Manager elements via
# ${__groovy(System.getenv("VAR_NAME"))} -- not ${__env(...)}, which looks
# like it should work but isn't a real JMeter function; it silently
# resolves to the literal placeholder text with no warning.
# Copy this file to .env and fill in real values; .env is already gitignored.
# These are NOT the same as this repo's own Boomi platform .env — this is
# for whatever API the *load test itself* is hitting.

BOOMI_TEST_TARGET_API_KEY=
BOOMI_TEST_TARGET_BASIC_AUTH_USER=
BOOMI_TEST_TARGET_BASIC_AUTH_PASS=
# auth: bearer (a fixed token)
BOOMI_TEST_TARGET_BEARER_TOKEN=
# auth: oauth2_client_credentials (the token_url goes in the profile, not here)
BOOMI_TEST_OAUTH_CLIENT_ID=
BOOMI_TEST_OAUTH_CLIENT_SECRET=

# Web console (console.sh): only needed when it listens beyond localhost (e.g. on a VM).
# At least 16 characters, e.g. generated with: openssl rand -hex 24
# CONSOLE_TOKEN=

# Database load tests (protocol: jdbc): login for the database under test. If unset, the bundled
# sample database login (loadtest / loadtest) is used. Never put these in a profile.
# BOOMI_TEST_DB_USER=
# BOOMI_TEST_DB_PASSWORD=
